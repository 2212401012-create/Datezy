# Browser-safe Supabase project URL + publishable/anon key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional static starter mode: real published Google Forms HTTPS link.
VITE_GOOGLE_FORM_URL=
VITE_SUPPORT_EMAIL=
# Set once using your canonical HTTPS deployment. No trailing slash.
VITE_SITE_URL=http://localhost:5173
# NEVER put a service-role key or password into a VITE_ variable.
